# ==============================================================================
# WanderLust AI (TravelX) - Environment Configuration Template
# NOTE: Copy this file to '.env' and populate with your private secrets.
# NEVER commit the actual '.env' file containing secrets to git or public repos.
# ==============================================================================

# Application Security
SECRET_KEY=wanderlust_super_secret_jwt_key_2026_change_in_production
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Database & Async Queue
DATABASE_URL=sqlite:///./wanderlust_local.db
REDIS_URL=redis://localhost:6379/0

# AI Intelligence Models & API Keys (Optional - Fallback heuristics active)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Media Storage Provider ('local', 'cloudinary', 's3')
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
CLOUDINARY_URL=
AWS_S3_BUCKET=
